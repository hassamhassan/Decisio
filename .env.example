# Decisio — copy to .env and fill in values
# Required for LLM
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Qdrant vector store (Decision Memory)
# Leave unset to use in-memory Qdrant for development (single process only).
# Local: QDRANT_URL=http://localhost:6333
# Docker: set in docker-compose (api uses http://qdrant:6333)
QDRANT_URL=http://localhost:6333
# Set to 1 to skip embeddings + Qdrant (no similar-case retrieval)
# DECISIO_DISABLE_RETRIEVAL=
# Gemini embeddings (hosted). Required when DECISIO_DISABLE_RETRIEVAL is not set.
# GEMINI_API_KEY=...
# Optional model + vector size (must match your Qdrant `decisio_patterns` collection):
# DECISIO_EMBEDDING_MODEL=gemini-embedding-001
# DECISIO_EMBEDDING_DIMENSION=768

# Docker Compose (optional — defaults in docker-compose.yml)
# Inside Compose, api still uses service DNS + standard container ports:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/decisio
# From your host (psql, GUI tools): localhost and mapped ports — defaults 5434 / 6380:
#   postgresql://postgres:postgres@localhost:5434/decisio
#   redis://localhost:6380/0
# Override host mapping: DECISIO_POSTGRES_PORT=5435 DECISIO_REDIS_PORT=6381
# JWT_SECRET_KEY=set-a-strong-secret-in-production
# WS_BASE_URL=http://localhost:8020
